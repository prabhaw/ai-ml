    {
      "cell_type": "code",
      "source": [
        "def summarize(*ags, **kgs):\n",
        "    print(\"Position of Args\", ags)\n",
        "    print(\"Keyword of Args\", kgs)\n",
        "\n",
        "\n",
        "\n",
        "summarize(\"hello\", 'how', name=\"prabhaw\")"
      ],
      "metadata": {

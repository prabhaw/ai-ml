        "print(type(num_int + num_float))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "DnLwHUOrKsjA",
        "outputId": "d17b6fbe-4fd0-49ad-e6ef-91709d182df8"
      },
